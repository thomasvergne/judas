module Counter(width: usize) {
    input clk: Clock
    input reset: Bool
    input enable: Bool

    output count: UInt<width>

    register count_reg: UInt<width> = 0

    count = count_reg

    on rising(clk) {
        if reset {
            count_reg = 0
        } else if enable {
            count_reg = count_reg + 1
        }
    }
}

